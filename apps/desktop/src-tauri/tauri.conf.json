{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BHAIPOS",
  "version": "0.1.0",
  "identifier": "com.bhaipos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "BHAIPOS", "width": 1024, "height": 768, "minWidth": 1024, "minHeight": 768, "resizable": true }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": { "digestAlgorithm": "sha256", "timestampUrl": "" }
  }
}
